function Transactions({tx,products,reload}){const [show,S]=useState(false),[type,T]=useState('sale'),[product,PR]=useState(''),[qty,Q]=useState('1'),[total,TO]=useState(''),[desc,D]=useState(''),[busy,B]=useState(false),[err,E]=useState('');const selected=products.find(p=>p.id===product);async function save(e){e.preventDefault();B(true);E('');const amount=Number(total)||Number(qty)*(type==='sale'?Number(selected?.selling_price||0):Number(selected?.cost_price||0));if(!amount){E('Weka kiasi cha muamala.');B(false);return;}const {error}=await supabase.from('transactions').insert({type,product_id:product||null,quantity:Number(qty)||1,total:amount,description:desc||selected?.name||'',occurred_at:new Date().toISOString()});if(error)E(error.message);else{if(product)await supabase.rpc('adjust_product_stock',{p_product_id:product,p_quantity:Number(qty)*(type==='sale'?-1:1)});S(false);reload()}B(false)}return <div className="content"><div className="toolbar"><div><h2 className="section-title">Miamala yote</h2><p className="muted">Rekodi mauzo na manunuzi ya biashara yako.</p></div><button className="primary" onClick={()=>S(true)}><Plus size={17}/> Rekodi muamala</button></div><div className="panel"><div className="table-wrap"><table><thead><tr><th>AINA</th><th>MAELEZO</th><th>IDADI</th><th>TAREHE</th><th>KIASI</th></tr></thead><tbody>{tx.map(t=><tr key={t.id}><td><span className={`type ${t.type}`}>{t.type==='sale'?'Mauzo':'Manunuzi'}</span></td><td>{t.description||'—'}</td><td>{t.quantity||1}</td><td>{new Date(t.occurred_at).toLocaleString('sw-TZ')}</td><td className="amount">{money(t.total)}</td></tr>)}</tbody></table></div>{tx.length===0&&<Empty text="Bado hakuna miamala iliyorekodiwa."/>}</div>{show&&<Modal title="Rekodi muamala" close={()=>S(false)}><form onSubmit={save}><label>Aina ya muamala</label><select value={type} onChange={e=>T(e.target.value)}><option value="sale">Mauzo</option><option value="purchase">Manunuzi</option></select><label>Chagua bidhaa (hiari)</label