 const chart=(()=>{const days=[];for(let i=6;i>=0;i--){const d=new Date();d.setDate(d.getDate()-i);const k=d.toISOString().slice(0,10);const dayTx=tx.filter(x=>String(x.occurred_at).slice(0,10)===k);days.push({day:d.toLocaleDateString('sw-TZ',{weekday:'short'}),Mauzo:dayTx.filter(x=>x.type==='sale').reduce((a,x)=>a+Number(x.total),0),Manunuzi:dayTx.filter(x=>x.type==='purchase').reduce((a,x)=>a+Number(x.total),0)});}return days;})();
